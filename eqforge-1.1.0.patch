@@ -0,0 +1,223 @@
+"""Always-on routing: EQForge in the audio path *before* audio starts.
+
+The problem this solves
+-----------------------
+In both deployments EQForge sits between an application and the speakers, and
+the interesting question is *when* it gets into the path:
+
+* **rt host** - applications are linked to the sink by WirePlumber the moment
+  their stream node appears. Routing them through `eqforge-rt` is a rewrite
+  of that decision, so it always happens *after* the first samples have
+  already gone straight to the sink. The daemon minimises that window
+  (registry events instead of a 2 s poll, see `eqforge.system.watch`), but
+  it cannot make it zero: something has to react.
+* **SPA filter node** - the node itself is resident from login, so a stream
+  can be linked into it from its first sample. Zero by construction.
+
+`always-on` therefore does the one thing a daemon cannot: it tells
+WirePlumber, in WirePlumber's own policy language, that new playback streams
+belong to EQForge. The stream is then *created* on EQForge's inputs - there is
+no moment in which the first second of programme material takes a shortcut
+around the processor.
+
+    app stream created  ->  WirePlumber links it to eqforge  ->  sink
+
+The daemon keeps its rewiring pass as a safety net (a rule can be shadowed by
+another policy drop-in, and hot-plug redeployments happen), so the two
+mechanisms layer: policy for "from the first sample", events for "whenever
+reality disagrees with policy".
+
+Scope and safety
+----------------
+* Only `Stream/Output/Audio` is matched. Microphones, MIDI, camera audio and
+  other people's filter nodes are untouched.
+* The target node must exist in the live graph before the rule is written -
+  a rule pointing at a name nobody owns is how a user ends up with silent
+  applications. `--node` overrides the auto-detected name.
+* `off` removes the drop-in and restarts WirePlumber; the daemon's rewiring
+  keeps working exactly as before, so nothing is lost but the zero-gap
+  behaviour.
+* WirePlumber >= 0.5 uses `node.rules` in a `.conf` drop-in. 0.4 needs the
+  Lua scripting API (`packaging/wireplumber/50-eqforge.lua.example`, shipped
+  with the repo); this module refuses on 0.4 instead of writing a file that
+  the session would ignore.
+"""
+from __future__ import annotations
+
+import os
+import re
+import subprocess
+from pathlib import Path
+
+from eqforge.errors import SystemError
+from eqforge.log import get_logger
+from eqforge.system import module_config as mc
+from eqforge.system import pipewire as pw
+
+log = get_logger("system.always_on")
+
+#: Node names, in the order they are preferred. `eqforge_filter` is the SPA
+#: filter node (module deployment); `eqforge` is the rt host's JACK client.
+DEFAULT_CANDIDATES = ("eqforge_filter", "eqforge")
+
+RULE_TEMPLATE = """\
+# EQForge always-on routing (generated by `eqforge system always-on on`).
+#
+# Every new application playback stream is created on EQForge's inputs instead
+# of the default sink, so it is processed from its very first sample - there is
+# no window in which the onset of playback bypasses the equalizer.
+#
+# Remove with `eqforge system always-on off` (or delete this file and
+# `systemctl --user restart wireplumber`). `eqforge system always-on status`
+# shows what is active.
+
+node.rules = [
+    {
+        matches = [
+            { media.class = "Stream/Output/Audio" }
+        ]
+        actions = {
+            update-props = {
+                target.object = "%(node)s"
+            }
+        }
+    }
+]
+"""
+
+
+def rule_file(home: Path | str | None = None) -> Path:
+    """Where the generated WirePlumber drop-in lives."""
+    base = Path(home) if home is not None else Path(os.path.expanduser("~"))
+    return (base / ".config/wireplumber/wireplumber.conf.d"
+            / "60-eqforge-streams.conf")
+
+
+def render_rule(node: str) -> str:
+    return RULE_TEMPLATE % {"node": node}
+
+
+def wireplumber_version() -> tuple[int, int] | None:
+    """Best-effort (major, minor) of the running WirePlumber, or None."""
+    for cmd in (["wireplumber", "--version"], ["wpctl", "--version"]):
+        try:
+            r = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
+        except (OSError, subprocess.TimeoutExpired):
+            continue
+        m = re.search(r"(\d+)\.(\d+)", (r.stdout or "") + (r.stderr or ""))
+        if m:
+            return int(m.group(1)), int(m.group(2))
+    return None
+
+
+def _supports_node_rules() -> bool:
+    """WirePlumber >= 0.5 reads `node.rules` from a `.conf` drop-in."""
+    ver = wireplumber_version()
+    if ver is None:
+        return True                 # unknown: assume modern, the rule is inert
+    return ver >= (0, 5)
+
+
+def detect_node() -> str | None:
+    """The EQForge node actually present in the graph, if any."""
+    if not pw.pipewire_available():
+        return None
+    try:
+        view = pw.snapshot()
+    except SystemError:
+        return None
+    for name in DEFAULT_CANDIDATES:
+        if view.node_id(name) is not None:
+            return name
+    return None
+
+
+def configured_node(path: Path | None = None) -> str | None:
+    """The node name written into the drop-in, if it is installed."""
+    p = path or rule_file()
+    if not p.exists():
+        return None
+    m = re.search(r'target\.object\s*=\s*"([^"]+)"', p.read_text(errors="replace"))
+    return m.group(1) if m else None
+
+
+def _restart_wireplumber() -> tuple[bool, str]:
+    try:
+        r = subprocess.run(["systemctl", "--user", "restart", "wireplumber"],
+                           capture_output=True, text=True, timeout=20)
+    except (OSError, subprocess.TimeoutExpired) as e:
+        return False, str(e)
+    return r.returncode == 0, (r.stderr or r.stdout or "").strip()[:200]
+
+
+def enable(node: str | None = None, *, restart: bool = False,
+           force: bool = False) -> dict:
+    """Install the always-on routing rule.
+
+    Returns a report dict; raises SystemError when the rule cannot be written
+    safely (no node to target, or a WirePlumber that would ignore it).
+    """
+    if not _supports_node_rules() and not force:
+        ver = wireplumber_version()
+        raise SystemError(
+            "WirePlumber %s does not read node.rules from a .conf drop-in" %
+            (".".join(map(str, ver)) if ver else "(unknown version)"),
+            hint="use the Lua policy in packaging/wireplumber/"
+                 "50-eqforge.lua.example, or pass --force if your "
+                 "WirePlumber does support node.rules")
+
+    target = node or detect_node()
+    if not target:
+        raise SystemError(
+            "no EQForge node in the audio graph to route streams to",
+            hint="start processing first (`eqforge system start`, or enable "
+                 "the SPA filter node), then re-run "
+                 "`eqforge system always-on on`; `eqforge devices` shows "
+                 "what the graph contains")
+    if node and pw.pipewire_available():
+        try:
+            seen = pw.snapshot().node_id(node) is not None
+        except SystemError:
+            seen = True                        # cannot check; trust the user
+        if not seen:
+            raise SystemError(
+                f"node {node!r} is not in the audio graph",
+                hint="`eqforge devices` lists the nodes PipeWire knows about")
+
+    path = rule_file()
+    status, backup = mc.write_managed(path, render_rule(target))
+    report = {"node": target, "file": str(path), "status": status,
+              "backup": str(backup) if backup else None, "restarted": False,
+              "error": None}
+    if restart:
+        ok, err = _restart_wireplumber()
+        report["restarted"] = ok
+        report["error"] = None if ok else err
+    return report
+
+
+def disable() -> dict:
+    """Remove the always-on rule (the daemon's rewiring keeps working)."""
+    path = rule_file()
+    existed = path.exists()
+    if existed:
+        path.unlink()
+    return {"file": str(path), "removed": existed}
+
+
+def status(node: str | None = None) -> dict:
+    """What `always-on` currently does, without changing anything."""
+    path = rule_file()
+    installed = path.exists()
+    wanted = configured_node(path) if installed else None
+    live = detect_node()
+    return {
+        "file": str(path),
+        "installed": installed,
+        "node": wanted,
+        "node_present": bool(live and wanted and live == wanted),
+        "live_node": live,
+        "wireplumber": wireplumber_version(),
+        "supported": _supports_node_rules(),
+        "ok": bool(installed and wanted and live == wanted),
+    }
diff --git a/eqforge/system/watch.py b/eqforge/system/watch.py
new file mode 100644
index 0000000..6dab040
--- /dev/null
+++ b/eqforge/system/watch.py
@@ -0,0 +1,252 @@
+"""Event-driven PipeWire graph watching.
+
+Why this exists
+---------------
+The daemon used to learn about the audio graph only on its polling tick (2 s).
+For device auto-switching that is fine - nobody notices a profile change a
+second late. For *routing* it is not: PipeWire destroys an application's
+stream node the moment it pauses, and creates a brand-new node when playback
+starts again, which WirePlumber links straight to the default sink. The
+daemon then had to notice, and move that stream through the processor - up to
+two seconds later. The audible result is exactly the reported symptom:
+
+    press play -> the first ~1 s is unprocessed, then the EQ "snaps in".
+
+`pw-dump --monitor` (`-m`) streams the same registry events WirePlumber acts
+on, as JSON, the instant they happen. Reacting to those turns a 2000 ms
+reaction into a ~30-60 ms one (debounce + one `pw-dump` snapshot + a couple
+of `pw-link` calls).
+
+Design notes
+------------
+* One background thread per watcher, one child process (`pw-dump -m`).
+* Events are *coalesced*: a single stream start generates a burst of node,
+  port and link events. Reacting to each one would run several rewiring
+  passes for one playback start; instead the first event starts a short
+  debounce window and the callback runs once per burst.
+* The callback runs on the watcher thread and must be cheap and must never
+  raise. Exceptions are logged and swallowed: a watcher that dies because a
+  single pass failed is worse than a slow one.
+* If `pw-dump -m` is unavailable (PipeWire < 0.3.56, or a tool that refuses
+  the flag) the watcher reports `event_capable == False` after giving up, and
+  the daemon keeps its polling tick as the only mechanism. Nothing breaks.
+* `EQFORGE_MONITOR_CMD` overrides the monitor command; the test suite uses
+  it to run a fake monitor instead of a real PipeWire session.
+"""
+from __future__ import annotations
+
+import os
+import select
+import shlex
+import shutil
+import subprocess
+import threading
+import time
+
+from eqforge.log import get_logger
+
+log = get_logger("system.watch")
+
+#: Object types worth reacting to. Nodes and links are what routing cares
+#: about; clients and metadata do not move audio, and reacting to them would
+#: just cost snapshots. The markers are the `type` strings pw-dump emits.
+RELEVANT_MARKERS = (
+    b"PipeWire:Interface:Node",
+    b"PipeWire:Interface:Link",
+)
+
+#: How long to wait after the first event of a burst before acting, so that a
+#: stream's node + ports + links are all in the graph when we look.
+DEFAULT_DEBOUNCE = 0.025
+
+#: Give the monitor this long to prove it works before declaring it dead.
+STARTUP_GRACE = 1.5
+
+
+def monitor_command() -> list[str]:
+    """The command that streams graph events (overridable for tests)."""
+    override = os.environ.get("EQFORGE_MONITOR_CMD")
+    if override:
+        return shlex.split(override)
+    return ["pw-dump", "-m"]
+
+
+def available() -> bool:
+    """True when a monitor could plausibly run in this session."""
+    cmd = monitor_command()
+    return bool(cmd) and shutil.which(cmd[0]) is not None
+
+
+class GraphWatcher:
+    """Push-style PipeWire graph notifications.
+
+    >>> w = GraphWatcher(lambda reason: print(reason))
+    >>> w.start()
+    >>> ...
+    >>> w.stop()
+
+    `on_change` receives a short reason string ("graph"). It is called from
+    the watcher thread, at most once per debounce window.
+    """
+
+    def __init__(self, on_change, *, debounce: float = DEFAULT_DEBOUNCE,
+                 cmd: list[str] | None = None, max_restarts: int = 5,
+                 restart_backoff: float = 1.0):
+        self._on_change = on_change
+        self._debounce = max(0.001, float(debounce))
+        self._cmd = list(cmd) if cmd else monitor_command()
+        self._max_restarts = int(max_restarts)
+        self._restart_backoff = float(restart_backoff)
+
+        self._thread: threading.Thread | None = None
+        self._stop = threading.Event()
+        self._proc: subprocess.Popen | None = None
+        self._lock = threading.Lock()
+
+        self.events = 0            # bursts delivered
+        self.raw_events = 0        # individual event chunks seen
+        self.restarts = 0
+        self.event_capable = available()
+        self.last_error: str | None = None
+
+    # ---------------------------------------------------------------- state
+    @property
+    def running(self) -> bool:
+        return self._thread is not None and self._thread.is_alive()
+
+    def start(self) -> bool:
+        """Start watching. False when no monitor tool is installed."""
+        if self.running:
+            return True
+        if not self._cmd or shutil.which(self._cmd[0]) is None:
+            self.event_capable = False
+            return False
+        self._stop.clear()
+        self._thread = threading.Thread(target=self._run, name="eqforge-watch",
+                                        daemon=True)
+        self._thread.start()
+        return True
+
+    def stop(self) -> None:
+        self._stop.set()
+        with self._lock:
+            proc = self._proc
+        if proc is not None:
+            try:
+                proc.terminate()
+            except OSError:
+                pass
+        if self._thread is not None:
+            self._thread.join(timeout=2.0)
+            self._thread = None
+
+    # --------------------------------------------------------------- worker
+    def _run(self) -> None:
+        first = True
+        while not self._stop.is_set():
+            if not self._spawn(first):
+                break
+            first = False
+            if self._stop.is_set():
+                break
+            if self.restarts >= self._max_restarts:
+                log.warning("graph watcher: giving up after %d restarts",
+                            self.restarts)
+                self.event_capable = False
+                break
+            self.restarts += 1
+            self._stop.wait(self._restart_backoff)
+        self._close_proc()
+
+    def _spawn(self, first: bool) -> bool:
+        started = time.monotonic()
+        try:
+            proc = subprocess.Popen(self._cmd, stdout=subprocess.PIPE,
+                                    stderr=subprocess.DEVNULL, bufsize=0)
+        except OSError as e:                      # pragma: no cover - env
+            self.last_error = str(e)
+            log.warning("graph watcher: cannot run %s (%s)", self._cmd[0], e)
+            self.event_capable = False
+            return False
+        with self._lock:
+            self._proc = proc
+        seen_output = False
+        pending = False            # an event arrived, not yet delivered
+        deadline = 0.0
+
+        while not self._stop.is_set():
+            fd = proc.stdout.fileno() if proc.stdout else -1
+            timeout = 0.2
+            if pending:
+                timeout = max(0.0, min(timeout, deadline - time.monotonic()))
+            try:
+                ready, _, _ = select.select([fd], [], [], timeout) if fd >= 0 \
+                    else ([], [], [])
+            except (OSError, ValueError):         # pragma: no cover - env
+                break
+            if not ready:
+                if proc.poll() is not None:
+                    break
+                if pending and time.monotonic() >= deadline:
+                    self._deliver()
+                    pending = False
+                continue
+            try:
+                chunk = os.read(fd, 65536)
+            except OSError:                       # pragma: no cover - env
+                break
+            if not chunk:
+                break
+            seen_output = True
+            if any(m in chunk for m in RELEVANT_MARKERS):
+                self.raw_events += 1
+                if not pending:
+                    pending = True
+                    deadline = time.monotonic() + self._debounce
+        rc = proc.poll()
+        self._close_proc()
+        if not seen_output and (time.monotonic() - started) < STARTUP_GRACE \
+                and rc not in (None, 0, -15):
+            # The tool exists but refused to monitor (old PipeWire, or a
+            # different `pw-dump`): stop trying, keep polling.
+            self.last_error = f"{self._cmd[0]} -m exited {rc}"
+            log.info("graph watcher: %s; falling back to polling",
+                     self.last_error)
+            self.event_capable = False
+            return False
+        return not self._stop.is_set()
+
+    def _deliver(self) -> None:
+        self.events += 1
+        try:
+            self._on_change("graph")
+        except Exception:                          # noqa: BLE001 - never die
+            log.debug("graph watcher callback failed", exc_info=True)
+
+    def _close_proc(self) -> None:
+        with self._lock:
+            proc, self._proc = self._proc, None
+        if proc is None:
+            return
+        try:
+            if proc.poll() is None:
+                proc.terminate()
+                try:
+                    proc.wait(timeout=1.0)
+                except subprocess.TimeoutExpired:  # pragma: no cover
+                    proc.kill()
+        except OSError:                             # pragma: no cover
+            pass
+        finally:
+            if proc.stdout is not None:
+                try:
+                    proc.stdout.close()
+                except OSError:                     # pragma: no cover
+                    pass
+
+    # ---------------------------------------------------------------- stats
+    def stats(self) -> dict:
+        return {"running": self.running, "event_capable": self.event_capable,
+                "events": self.events, "raw_events": self.raw_events,
+                "restarts": self.restarts, "command": self._cmd,
+                "error": self.last_error}
